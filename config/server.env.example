# MySQL配置。不要把真实密码提交到GitHub，部署时复制为 .env 或 export 到shell中。
export CHAT_DB_HOST=127.0.0.1
export CHAT_DB_PORT=3306
export CHAT_DB_USER=root
export CHAT_DB_PASSWORD=123456
export CHAT_DB_NAME=chat

# Redis配置。单节点本地调试可保持默认；多节点部署时所有ChatServer需指向同一个Redis。
export CHAT_REDIS_HOST=127.0.0.1
export CHAT_REDIS_PORT=6379
export CHAT_REDIS_PASSWORD=
export CHAT_REDIS_DB=0
